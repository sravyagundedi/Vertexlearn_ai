# ==============================================================================
# VertexLearn AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Docker Compose will automatically read these variables into all services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=vertexlearn
POSTGRES_PASSWORD=vertexlearn
POSTGRES_DB=vertexlearn

# Internal Docker-to-Docker Database Connection String (used by backend and ai-service)
DATABASE_URL=postgres://vertexlearn:vertexlearn@db:5432/vertexlearn

# ------------------------------------------------------------------------------
# 2. Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# In production, generate strong 256-bit random secrets
JWT_SECRET=vertexlearn-jwt-access-secret-production-change-me
JWT_REFRESH_SECRET=vertexlearn-jwt-refresh-secret-production-change-me

# ------------------------------------------------------------------------------
# 4. AI Service & Provider Configuration
# ------------------------------------------------------------------------------
# Internal Docker URL for backend to reach AI service
AI_SERVICE_URL=http://ai-service:8001

# Anthropic Claude API Key
# REQUIRED for live AI completions (AI Tutor, Quiz generation, Summarization).
# If this variable is empty, the application will display:
# "AI service is not configured. Add the required AI provider API key to the environment configuration."
# DO NOT commit real API keys to version control.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional: Dedicated Vector Embedding Provider Key
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration
# ------------------------------------------------------------------------------
# Public API URL used by the user's browser to connect to the backend
VITE_API_URL=http://localhost:8000/api/v1
